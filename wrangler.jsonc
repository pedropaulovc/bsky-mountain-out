{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bsky-mountain-out",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-17",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"triggers": {
		"crons": [
			"*/20 * * * *"
		]
	},
	"assets": {
		"directory": "./assets",
		"binding": "ASSETS"
	},
	"kv_namespaces": [
		{
			"binding": "STATE",
			"id": "b2f07d5ca4724fdcaa6a82e78a99148f",
			"preview_id": "8817542bf88d49558da7cc79983fd758"
		}
	],
	"vars": {
		"MODEL_ID": "gpt-5.6-luna",
		"OPENAI_API_URL": "https://api.openai.com/v1",
		"CLASSIFIER_REASONING_EFFORT": "medium",
		"CLASSIFIER_REFERENCE_URLS": "/references/morning-visible.jpg,/references/morning-not-visible.jpg,/references/afternoon-visible.jpg,/references/afternoon-not-visible.jpg,/references/evening-visible.jpg,/references/evening-not-visible.jpg",
		"BSKY_SERVICE_URL": "https://ismtrainierout.selfhosted.social",
		"IMAGE_MODE": "stitched",
		"POSTING_ENABLED": "false",
	},
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": false,
			"invocation_logs": true,
			"destinations": [
				"azure-appi-logs"
			]
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": false,
			"destinations": [
				"azure-appi-traces"
			]
		}
	}
}